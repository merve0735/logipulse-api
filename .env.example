# --- App ---
PROJECT_NAME=LogiPulse API
# development | production
ENVIRONMENT=development
API_PREFIX=/api/v1

# --- Database ---
# Local docker compose (dev): mongodb://admin:secret_password@mongodb:27017
# Prod compose reads MONGO_INITDB_ROOT_USERNAME/PASSWORD below for the mongo
# container itself — if you change those, update MONGO_URI to match.
MONGO_URI=mongodb://admin:secret_password@mongodb:27017
MONGO_DB_NAME=logipulse

# Only used by docker-compose.prod.yml to set the MongoDB container's root user.
# Must match the credentials embedded in MONGO_URI above.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_this_password_before_production

# --- Auth ---
# CHANGE THIS before any real deployment — use a long random string
# (e.g. `openssl rand -hex 32`), never the example value below.
JWT_SECRET_KEY=change_this_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Gemini AI Advisor ---
# Never commit a real key. Leave empty to disable the AI Advisor endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins. In production, list only your
# real frontend/demo-panel domain(s) — never use "*".
# Example (production): CORS_ORIGINS=https://logipulse.example.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
