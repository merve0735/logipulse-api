# Secrets - never bake these into an image
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Tests (not needed at runtime, kept out of the production image)
tests/

# Editor/OS/tooling
.vscode/
.idea/
.claude/
*.log

# Docs and non-runtime project files
docs/
postman/
README.md
